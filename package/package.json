{
  "name": "breadchunks",
  "version": "0.2.3",
  "description": "Heading-aware, token-budgeted semantic chunker for Markdown — for RAG and embedding pipelines.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "*.node"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanong/breadchunks.git"
  },
  "keywords": [
    "markdown",
    "chunking",
    "rag",
    "embedding",
    "llm"
  ],
  "scripts": {
    "build": "napi build --platform --release && node patch.js",
    "build:debug": "napi build --platform && node patch.js",
    "test": "node --test __test__/*.spec.mjs",
    "coverage": "c8 node --test __test__/*.spec.mjs"
  },
  "napi": {
    "binaryName": "breadchunks",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2",
    "c8": "^12.0.0"
  },
  "engines": {
    "node": ">= 18"
  }
}
