{
  "name": "breadchunks",
  "version": "0.1.0",
  "description": "Heading-aware, token-budgeted semantic chunker for Markdown — for RAG and embedding pipelines.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonathanong/breadchunks"
  },
  "keywords": [
    "markdown",
    "chunking",
    "rag",
    "embedding",
    "llm"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test __test__/*.spec.mjs",
    "coverage": "c8 node --test __test__/*.spec.mjs"
  },
  "napi": {
    "name": "breadchunks",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.2",
    "c8": "^11.0.0"
  },
  "engines": {
    "node": ">= 18"
  }
}
